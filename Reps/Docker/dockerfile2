# Podstawowy zestaw narzędzi:

#     docker ps – lista działających kontenerów (dodaj -a, by zobaczyć też te zatrzymane).

#     docker logs -f <kontener> – podgląd logów aplikacji (flaga -f śledzi logi na żywo).

#     docker stop <kontener> – bezpieczne zatrzymanie kontenera.

#     docker rm <kontener> – usunięcie zatrzymanego kontenera.

#     docker exec -it <kontener> sh – wejście do wnętrza działającego kontenera w celu inspekcji.

FROM nginx:alpine
COPY ./index.html /usr/share/nginx/html/index.html
EXPOSE 80

